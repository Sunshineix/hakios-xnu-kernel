# HakiOS fragment: the Qualcomm SM8850 (Snapdragon 8 Elite Gen 5, "canoe"/"kaanapali") -- a new SoC layer, its drivers not ported yet.
# CPU facts from the phone's own tree (X9U-iOS移植/scripts/dtb_cpu.py): 6x Oryon M (cpu 0-5, 3.63 GHz) + 2x Oryon L (cpu 6-7, 4.61 GHz).
# The common kernel's per-SoC drivers carry the SC7280 family's addresses as their defaults, which are wrong on SM8850,
# so they stay out until each is ported (docs/porting/index.md, step 3: CPUFREQ -> THERMAL -> SOCINFO first).
CONFIG_SOC="sm8850"
CONFIG_CPUS=8
CONFIG_BOOTCPU=7
# CONFIG_CPUFREQ is not set
# CONFIG_SOCINFO is not set
# CONFIG_THERMAL is not set
# CONFIG_PMIC is not set
# CONFIG_HAKIOS_CPUFREQ is not set
# CONFIG_HAKIOS_SOCINFO is not set
# CONFIG_HAKIOS_THERMAL is not set
# CONFIG_HAKIOS_PMIC is not set
# CONFIG_HAKIOS_BATTGUARD is not set
